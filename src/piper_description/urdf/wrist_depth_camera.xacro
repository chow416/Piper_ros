<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Shared eye-in-hand RGB-D camera model.

    Both the regular MoveIt robot description and the Gazebo description use
    this macro, so TF, collision checking and simulation always contain the
    same physical camera links.  Only the Gazebo description enables the
    actual rendering sensor and ROS publisher plugin.
  -->
  <xacro:macro name="wrist_depth_camera" params="parent_link enable_gazebo:=false">
    <link name="wrist_depth_camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.05" />
        <inertia ixx="0.000006" ixy="0" ixz="0"
                 iyy="0.000008" iyz="0" izz="0.000010" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.04 0.03 0.025" />
        </geometry>
        <material name="wrist_camera_dark">
          <color rgba="0.08 0.10 0.12 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.04 0.03 0.025" />
        </geometry>
      </collision>
    </link>

    <!-- camera_link X is forward and points along the gripper tool direction. -->
    <joint name="wrist_depth_camera_joint" type="fixed">
      <!--
        gripper_base X points down at the home pose; the negative X offset
        therefore places the lens above the gripper and level with the target.
      -->
      <origin xyz="-0.035 0 0.07" rpy="0 -1.57079632679 0" />
      <parent link="${parent_link}" />
      <child link="wrist_depth_camera_link" />
    </joint>

    <!-- REP-103 optical convention: Z forward, X right, Y down. -->
    <link name="wrist_depth_camera_optical_frame" />
    <joint name="wrist_depth_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
      <parent link="wrist_depth_camera_link" />
      <child link="wrist_depth_camera_optical_frame" />
    </joint>

    <xacro:if value="${enable_gazebo}">
      <gazebo reference="wrist_depth_camera_link">
        <sensor name="wrist_depth_camera" type="depth">
          <always_on>true</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <camera>
            <!-- 80 degrees keeps all three simulated buttons in view. -->
            <horizontal_fov>1.3962634016</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <depth_camera />
            <clip>
              <near>0.10</near>
              <far>2.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </camera>
          <plugin name="wrist_depth_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/wrist_camera</namespace>
            </ros>
            <camera_name>depth</camera_name>
            <frame_name>wrist_depth_camera_optical_frame</frame_name>
            <min_depth>0.10</min_depth>
            <max_depth>2.0</max_depth>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
