<?xml version="1.0"?>
<package format="3">
  <name>piper_marker_perception</name>
  <version>0.1.0</version>
  <description>
    ArUco board detection for the press task: solves the board pose in
    base_link and maps it to the button target the planner consumes.
  </description>
  <maintainer email="zlf@example.com">zlf</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
