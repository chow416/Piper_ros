<?xml version="1.0"?>
<sdf version="1.6">
  <world name="elevator_button_lab">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Expose model-state topics and pose services for synthetic data. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Convenient overview when the optional Gazebo client is enabled. -->
    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>1.40 -1.40 1.10 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <light name="ceiling_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- The floor is 0.80 m below the robot base. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.825 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>6 6 0.05</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>6 6 0.05</size></box></geometry>
          <material>
            <ambient>0.32 0.35 0.38 1</ambient>
            <diffuse>0.42 0.45 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table top surface is exactly z=0, matching the robot base frame. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 -0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.80 0.08</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 -0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.80 0.08</size></box></geometry>
          <material>
            <ambient>0.43 0.25 0.12 1</ambient>
            <diffuse>0.62 0.38 0.20 1</diffuse>
          </material>
        </visual>

        <collision name="front_left_leg_collision">
          <pose>0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="front_left_leg_visual">
          <pose>0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="front_right_leg_collision">
          <pose>0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="front_right_leg_visual">
          <pose>0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="rear_left_leg_collision">
          <pose>-0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="rear_left_leg_visual">
          <pose>-0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="rear_right_leg_collision">
          <pose>-0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="rear_right_leg_visual">
          <pose>-0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      The press target is intentionally virtual.  No panel or button collision
      object is placed here: planning receives a world-frame point and press
      direction directly from the launch parameters.
    -->
  </world>
</sdf>
