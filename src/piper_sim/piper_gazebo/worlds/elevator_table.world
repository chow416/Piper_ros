<?xml version="1.0"?>
<sdf version="1.6">
  <world name="elevator_button_lab">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Expose model-state topics and pose services for synthetic data. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Convenient overview when the optional Gazebo client is enabled. -->
    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>1.40 -1.40 1.10 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <light name="ceiling_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- The floor is 0.80 m below the robot base. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.825 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>6 6 0.05</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>6 6 0.05</size></box></geometry>
          <material>
            <ambient>0.32 0.35 0.38 1</ambient>
            <diffuse>0.42 0.45 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table top surface is exactly z=0, matching the robot base frame. -->
    <model name="work_table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 -0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.80 0.08</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 -0.04 0 0 0</pose>
          <geometry><box><size>1.20 0.80 0.08</size></box></geometry>
          <material>
            <ambient>0.43 0.25 0.12 1</ambient>
            <diffuse>0.62 0.38 0.20 1</diffuse>
          </material>
        </visual>

        <collision name="front_left_leg_collision">
          <pose>0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="front_left_leg_visual">
          <pose>0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="front_right_leg_collision">
          <pose>0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="front_right_leg_visual">
          <pose>0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="rear_left_leg_collision">
          <pose>-0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="rear_left_leg_visual">
          <pose>-0.48 0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>

        <collision name="rear_right_leg_collision">
          <pose>-0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
        </collision>
        <visual name="rear_right_leg_visual">
          <pose>-0.48 -0.31 -0.42 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.76</size></box></geometry>
          <material><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      A small elevator button panel.  Its centre button front surface is at
      base_link (0.300, 0.000, 0.240), matching press_button_demo defaults.
    -->
    <model name="elevator_button_panel">
      <static>true</static>
      <link name="panel_link">
        <collision name="panel_collision">
          <pose>0.330 0 0.250 0 0 0</pose>
          <geometry><box><size>0.030 0.300 0.380</size></box></geometry>
        </collision>
        <visual name="panel_visual">
          <pose>0.330 0 0.250 0 0 0</pose>
          <geometry><box><size>0.030 0.300 0.380</size></box></geometry>
          <material>
            <ambient>0.45 0.48 0.52 1</ambient>
            <diffuse>0.72 0.75 0.78 1</diffuse>
            <specular>0.90 0.90 0.90 1</specular>
          </material>
        </visual>

        <collision name="panel_foot_collision">
          <pose>0.330 0 0.025 0 0 0</pose>
          <geometry><box><size>0.16 0.34 0.05</size></box></geometry>
        </collision>
        <visual name="panel_foot_visual">
          <pose>0.330 0 0.025 0 0 0</pose>
          <geometry><box><size>0.16 0.34 0.05</size></box></geometry>
          <material><diffuse>0.25 0.27 0.30 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!--
      Each button is a separate Gazebo model.  Besides making the scene easier
      to edit, /gazebo/model_states can be used as synthetic-data ground truth.
      Cylinder axes are rotated onto X and the front surfaces face the robot.
    -->
    <model name="elevator_button_blue">
      <static>true</static>
      <pose>0.306 0 0.320 0 1.57079632679 0</pose>
      <link name="button_link">
        <collision name="button_collision">
          <geometry><cylinder><radius>0.023</radius><length>0.012</length></cylinder></geometry>
        </collision>
        <visual name="button_visual">
          <geometry><cylinder><radius>0.023</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.03 0.12 0.48 1</ambient>
            <diffuse>0.05 0.25 0.95 1</diffuse>
            <emissive>0.01 0.04 0.14 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red is the default demo target at base_link (0.300, 0, 0.240). -->
    <model name="elevator_button_red">
      <static>true</static>
      <pose>0.306 0 0.240 0 1.57079632679 0</pose>
      <link name="button_link">
        <collision name="button_collision">
          <geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry>
        </collision>
        <visual name="button_visual">
          <geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.48 0.02 0.02 1</ambient>
            <diffuse>0.95 0.05 0.04 1</diffuse>
            <emissive>0.16 0.01 0.01 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="elevator_button_green">
      <static>true</static>
      <pose>0.306 0 0.160 0 1.57079632679 0</pose>
      <link name="button_link">
        <collision name="button_collision">
          <geometry><cylinder><radius>0.023</radius><length>0.012</length></cylinder></geometry>
        </collision>
        <visual name="button_visual">
          <geometry><cylinder><radius>0.023</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.02 0.38 0.06 1</ambient>
            <diffuse>0.04 0.82 0.10 1</diffuse>
            <emissive>0.01 0.12 0.02 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
